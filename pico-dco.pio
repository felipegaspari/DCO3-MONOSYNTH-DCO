.program frequency
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR  side 0
lp1:
jmp x-- lp1
pull_1:
    mov x, OSR
lp2:
jmp x-- lp2
pull_2:
    mov x, OSR
lp3:
jmp x-- lp3
pull_3:
    mov x, OSR
lp4:
jmp x-- lp4
pull_4:
    mov x, OSR
lp5:
jmp x-- lp5
pull_5:
    mov x, OSR
lp6:
jmp x-- lp6
pull_6:
mov x, OSR
lp7:
jmp x-- lp7
pull_7:
    mov x, OSR
loop_final:
    jmp x-- loop_final
    mov x, y  side 1
.wrap

% c-sdk {
void init_sm_pin(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_config c = frequency_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_set_pins(&c, pin, 1);
    pio_sm_init(pio, sm, offset, &c);
}
%}

.program frequency_sync
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR
    set pins, 0     side 0
lp1:
jmp x-- lp1
pull_1:
    mov x, OSR
lp2:
jmp x-- lp2
pull_2:
    mov x, OSR
lp3:
jmp x-- lp3
pull_3:
    mov x, OSR
lp4:
jmp x-- lp4
pull_4:
    mov x, OSR
lp5:
jmp x-- lp5
pull_5:
    mov x, OSR
lp6:
jmp x-- lp6
pull_6:
mov x, OSR
lp7:
jmp x-- lp7
pull_7:
    mov x, OSR
loop_final:
    jmp x-- loop_final
    mov x, y  
    set pins, 1    side 1
.wrap

% c-sdk {
void frequency_sync(PIO pio, uint sm, uint offset, uint pin, uint pin2) {
    pio_sm_config c = frequency_sync_program_get_default_config(offset);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin2); 
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin2);   
    pio_sm_init(pio, sm, offset, &c);
}
%}


.program frequency_sync_4_jumps
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR
    set pins, 0     side 0
lp1:
jmp x-- lp1
pull_1:
    mov x, OSR
lp2:
jmp x-- lp2
pull_2:
    mov x, OSR
lp3:
jmp x-- lp3
pull_3:
    mov x, OSR
loop_final:
    jmp x-- loop_final
    mov x, y  
    set pins, 1    side 1
.wrap

% c-sdk {
void frequency_sync_4_jumps(PIO pio, uint sm, uint offset, uint pin, uint pin2) {
    pio_sm_config c = frequency_sync_4_jumps_program_get_default_config(offset);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin2); 
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin2);   
    pio_sm_init(pio, sm, offset, &c);
}
%}


; Soft-sync slave variants of frequency_sync_4_jumps. Trailing ramp chunks poll the
; master's reset pin via jmp_pin, so the slave restarts its own count on a master
; edge instead of only having its integrator discharged. Each polled chunk costs two
; cycles per iteration (jmp pin + jmp x--), so the period model is
;   period = Y + (4+N)*clk_div + (12+N)
; for N trailing polled chunks (see PIO_RAMP_WEIGHT_BY_CHUNKS in globals.h).
;
; Only one poll image is resident on pio0 at a time alongside the free-running
; program; deeper thresholds swap the loaded variant (see ensure_soft_sync_program).
; The sync branch and the ordinary count-expired fall-through both land on do_sync.
.program frequency_sync_poll
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR
    set pins, 0     side 0
lp1:
    jmp x-- lp1
    mov x, OSR
lp2:
    jmp x-- lp2
    mov x, OSR
lp3:
    jmp x-- lp3
    mov x, OSR
loop_final:
    jmp pin, do_sync
    jmp x-- loop_final
do_sync:
    mov x, y
    set pins, 1     side 1
.wrap

; N=2: last two chunks poll. Weight 6, overhead 14, receptive ~4/6 of ramp.
.program frequency_sync_poll_2
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR
    set pins, 0     side 0
lp1:
    jmp x-- lp1
    mov x, OSR
lp2:
    jmp x-- lp2
    mov x, OSR
lp3:
    jmp pin, do_sync
    jmp x-- lp3
    mov x, OSR
loop_final:
    jmp pin, do_sync
    jmp x-- loop_final
do_sync:
    mov x, y
    set pins, 1     side 1
.wrap

; N=3: last three chunks poll. Weight 7, overhead 15, receptive ~6/7 of ramp.
.program frequency_sync_poll_3
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR
    set pins, 0     side 0
lp1:
    jmp x-- lp1
    mov x, OSR
lp2:
    jmp pin, do_sync
    jmp x-- lp2
    mov x, OSR
lp3:
    jmp pin, do_sync
    jmp x-- lp3
    mov x, OSR
loop_final:
    jmp pin, do_sync
    jmp x-- loop_final
do_sync:
    mov x, y
    set pins, 1     side 1
.wrap

% c-sdk {
// Slave SM for soft sync. Same pin/sideset wiring as frequency_sync_4_jumps plus
// jmp_pin aimed at the master's reset GPIO. masterPin is deliberately not
// pio_gpio_init'd here: the master SM already owns it, and PIO input sampling reads
// the pad regardless of function select. `chunks` selects wrap/config for the
// resident poll variant (1, 2, or 3 trailing polled chunks).
void frequency_sync_poll_init(PIO pio, uint sm, uint offset, uint pin, uint pin2,
                              uint masterPin, uint chunks) {
    pio_sm_config c;
    if (chunks >= 3) {
        c = frequency_sync_poll_3_program_get_default_config(offset);
    } else if (chunks == 2) {
        c = frequency_sync_poll_2_program_get_default_config(offset);
    } else {
        c = frequency_sync_poll_program_get_default_config(offset);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin2);
    sm_config_set_jmp_pin(&c, masterPin);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin2);
    pio_sm_init(pio, sm, offset, &c);
}
%}

; RANGE dither (see range_pwm_dither.pio.h): pio1 SM2/SM3 + pio0 SM3, same pins as slice PWM.
; 1-cycle-per-count PWM: DMA word = (low << 16) | high, autopull 32. 3-frame dither
; (wrap 4666, chained DMA) is not extra PIO inst (program is 4 slots, loaded per block).
; .program range_pwm_dither
; .side_set 1 opt
; .wrap_target
;     out x, 16
;     out y, 16
; high:
;     jmp x-- high    side 1
; low:
;     jmp y-- low     side 0
; .wrap

; White noise LFSR for CPU coloring + optional pin listen (ENABLE_NOISE_OUT).
; 32-bit Fibonacci trinomial x^31+x^28+1; pushes one word every 32 steps.
; mov pins, isr emits bit0 each step when OUT pins are mapped.
; MUST load at origin 0 on PIO1 (out pc,1 XORs via absolute addresses 0/1).
; Adapted from PicoTinker forum recipe (Unlicense OR CC0-1.0).
.program noise_lfsr
.define public n 31
.define public k 28
.define public l 32
.in 32 left manual
.out 0 left manual
.origin 0
    jmp  retain
    mov  x, ~x
retain:
    in   x, 1
    mov  pins, isr
    mov  osr, isr
    jmp  y--, skip
    push
public entry:
    set  y, 31
    mov  isr, osr
skip:
    out  x, 2
    out  null, 2
    out  pc, 1

; Sub-oscillator: toggles its output every N master reset pulses, giving a 50% duty
; square one (div2) or two (div4) octaves below the master. Each master cycle
; contributes one rising and one falling edge, so a wait pair consumes one cycle.
.program subosc_div2
.side_set 1 opt
.wrap_target
    wait 1 pin 0    side 0
    wait 0 pin 0
    wait 1 pin 0    side 1
    wait 0 pin 0
.wrap

.program subosc_div4
.side_set 1 opt
.wrap_target
    wait 1 pin 0    side 0
    wait 0 pin 0
    wait 1 pin 0
    wait 0 pin 0
    wait 1 pin 0    side 1
    wait 0 pin 0
    wait 1 pin 0
    wait 0 pin 0
.wrap

; Sub-oscillator with programmable phase offset and pulse width (ENABLE_SUBOSC_ENGINE2).
; One resident copy on pio2 serves both subs: SM index == sub index, each with its own IN pin
; (the RESET pad of whichever oscillator that sub follows) and sideset pin (its sub output).
;
; A sub period is two segments, low then high. A segment is "Cn whole master flybacks,
; then Fn fine system-clock cycles", pulled from the FIFO as three words per period:
;   Cl | Ch<<16, Fl, Fh
; Counting flybacks is what locks the frequency: Cl + Ch always equals the divide ratio,
; so phase and width can move the two edges anywhere inside the period without ever
; detuning the sub. The fine value is an absolute offset from the flyback it follows, so
; "phase" really is "delay the sub edge N cycles after the master resets".
;
; Both counts arrive in one word, split into Y and X up front, because that invariant has
; to survive the CPU rewriting the stream while the DMA is reading it: a mix of an old Cl
; and a new Ch would not sum to the divide ratio and the sub would drop or gain a master
; period. One word cannot be torn. Mixing an old fine value with a new one is harmless -
; it moves an edge by a few cycles - so those stay separate.
;
; Instruction overhead does not accumulate into the period: every segment ends by waiting
; for a level, so the few cycles spent on pull/mov/jmp are absorbed into that wait. The
; only requirement is that a fine delay must never run long enough to swallow the flyback
; the next segment is waiting for (the CPU clamps for that).
;
; The test-at-top loop shape (jmp !y before the body) makes a count of zero legal, which
; is what pulses narrower than one master period need.
.program subosc_seg
.side_set 1 opt
.wrap_target
    pull                        ; Cl | Ch<<16: whole master periods per segment
    out y, 16           side 0  ; Y = Cl, sub low (falling edge of the previous period)
    out x, 16                   ; X = Ch, parked until the high segment
low_test:
    jmp !y, low_fine
    wait 1 pin 0
    wait 0 pin 0
    jmp y-- low_test
low_fine:
    pull                        ; Fl: fine cycles before the rising edge
    mov y, osr
low_delay:
    jmp y-- low_delay
    mov y, x            side 1  ; sub high
high_test:
    jmp !y, high_fine
    wait 1 pin 0
    wait 0 pin 0
    jmp y-- high_test
high_fine:
    pull                        ; Fh: fine cycles before the falling edge
    mov y, osr
high_delay:
    jmp y-- high_delay
.wrap

; Boolean logic combiner for two sub outputs: digital ring modulation, the SID trick.
;
; The two sub pins are read as a 2-bit number and used as an index straight into a
; four-entry jump table, one entry per input combination, each side-setting the output to
; that combination's result. The operator therefore lives entirely in the table, so
; switching between XOR / AND / OR / XNOR / NAND / NOR - or a pass-through of either input on
; its own, which is just as expressible as a truth table - is four instruction-memory writes
; with no reconfiguration. The logic operators are symmetric; the pass-throughs are not, so
; which sub landed on the IN base does matter.
;
; `out pc, 2` is an absolute jump, so this program has to be loaded at instruction 0 of the
; block (hence .origin 0, and subosc_seg is parked above it).
;
; Five cycles per sample: at 225 MHz the output follows its inputs within ~22 ns, which is
; nothing next to an audio-rate edge.
;
; Shift directions are not the defaults. IN must shift left so `in pins, 2` leaves the two
; bits in the *low* end of the ISR, and OUT must shift right so `out pc, 2` reads them from
; that same end. The default pairing (both right) would hand `out pc` two zero bits and the
; program would only ever jump to entry 0.
.program subosc_logic
.origin 0
.side_set 1 opt
    jmp entry           side 0  ; 0: sub1=0 sub2=0
    jmp entry           side 1  ; 1: sub1=1 sub2=0   (default table is XOR)
    jmp entry           side 1  ; 2: sub1=0 sub2=1
    jmp entry           side 0  ; 3: sub1=1 sub2=1
entry:
    mov isr, null               ; clears the input shift counter as well as the data
    in pins, 2                  ; IN base = sub 1's pin, sub 2 on the pin above it
    mov osr, isr                ; MOV to OSR marks it full, so no pull is needed
    out pc, 2

% c-sdk {
// Boolean combiner. Both inputs are pads this same PIO block already drives from the sub
// SMs, which is fine - a PIO can always read a pin it owns - but they must be adjacent
// GPIOs, because an SM has exactly one IN base. outPin has to be a third pad: two SMs in
// one block driving the same pin fight each other.
void subosc_logic_init(PIO pio, uint sm, uint inBase, uint outPin) {
    pio_sm_config c = subosc_logic_program_get_default_config(0);
    sm_config_set_in_pins(&c, inBase);
    sm_config_set_in_shift(&c, false, false, 32);   // shift left, no autopush
    sm_config_set_out_shift(&c, true, false, 32);   // shift right, no autopull
    sm_config_set_sideset_pins(&c, outPin);
    pio_sm_set_consecutive_pindirs(pio, sm, outPin, 1, true);
    pio_gpio_init(pio, outPin);
    pio_sm_init(pio, sm, 0, &c);
}
%}

% c-sdk {
// One sub. masterPin is its master oscillator's RESET pad and is an input only - do
// NOT pio_gpio_init it, that would move its function select to pio2 and steal the reset
// output away from pio0.
void subosc_seg_init(PIO pio, uint sm, uint offset, uint masterPin, uint outPin) {
    pio_sm_config c = subosc_seg_program_get_default_config(offset);
    sm_config_set_in_pins(&c, masterPin);
    sm_config_set_sideset_pins(&c, outPin);
    pio_sm_set_consecutive_pindirs(pio, sm, outPin, 1, true);
    pio_gpio_init(pio, outPin);
    pio_sm_init(pio, sm, offset, &c);
}
%}

% c-sdk {
// Sub-oscillator init. masterPin is an input only - do NOT pio_gpio_init it, that
// would move its function select to this block and steal the output from pio0.
void subosc_init(PIO pio, uint sm, uint offset, uint masterPin, uint outPin, bool div4) {
    pio_sm_config c = div4 ? subosc_div4_program_get_default_config(offset)
                           : subosc_div2_program_get_default_config(offset);
    sm_config_set_in_pins(&c, masterPin);
    sm_config_set_sideset_pins(&c, outPin);
    pio_sm_set_consecutive_pindirs(pio, sm, outPin, 1, true);
    pio_gpio_init(pio, outPin);
    pio_sm_init(pio, sm, offset, &c);
}
%}

.program frequency
.side_set 1 opt
.wrap_target
lp0:
    jmp x-- lp0
    mov x, OSR  side 0
lp1:
jmp x-- lp1
pull_1:
    mov x, OSR
lp2:
jmp x-- lp2
pull_2:
    mov x, OSR
lp3:
jmp x-- lp3
pull_3:
    mov x, OSR
lp4:
jmp x-- lp4
pull_4:
    mov x, OSR
lp5:
jmp x-- lp5
pull_5:
    mov x, OSR
lp6:
jmp x-- lp6
pull_6:
mov x, OSR
lp7:
jmp x-- lp7
pull_7:
    mov x, OSR
loop_final:
    jmp x-- loop_final
    mov x, y  side 1
.wrap

% c-sdk {
void init_sm_pin(PIO pio, uint sm, uint offset, uint pin, uint pin2) {
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin2);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_config c = frequency_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_sideset_pins(&c, pin2);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_set_pins(&c, pin2, 1);
    pio_sm_init(pio, sm, offset, &c);
}
%}

.program frequency_pulse1
.side_set 1 opt
    mov x, isr      side 0
    nop   
loopOff:
    jmp x--  loopOff  
    mov x, y        side 1
loopOn:
    jmp x--  loopOn


% c-sdk {
static inline void frequency_pulse1_program_init(PIO pio, uint sm, uint offset, uint pin) {
   pio_gpio_init(pio, pin);
   pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
   pio_sm_config c = frequency_pulse1_program_get_default_config(offset);
   sm_config_set_sideset_pins(&c, pin);
   sm_config_set_set_pins(&c, pin, 1);
   pio_sm_init(pio, sm, offset, &c);
}
%}
